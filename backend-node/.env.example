NODE_ENV=development
PORT=3000
PYTHON_API_URL=http://localhost:5001
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
APP_URL=http://localhost:3000

# Resend: usado na redefinição de senha e nos alertas de queda.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="AI Health <nao-responda@seu-dominio.com>"

# Alertas de queda. Comece com DRY_RUN=true para não enviar mensagens reais.
ALERTS_ENABLED=true
ALERT_DRY_RUN=true
ALERT_TIMEZONE=America/Sao_Paulo
ALERT_COOLDOWN_SECONDS=60
ALERT_IMAGE_QUALITY=85
ALERT_IMAGE_MAX_WIDTH=960
ALERT_HTTP_TIMEOUT=20

# Detecção de queda. "auto" separa automaticamente o quadro vertical com duas
# lentes; use "single" para câmeras que entregam uma única imagem.
YOLO_FRAME_LAYOUT=auto
YOLO_DETECTION_CONFIDENCE=0.25
YOLO_FALL_THRESHOLD=0.52
YOLO_CONFIRMATION_FRAMES=3
YOLO_RELEASE_FRAMES=5

# Um ou mais e-mails separados por vírgula.
ALERT_EMAIL_TO=cuidador@example.com

# WhatsApp Cloud API oficial da Meta. Use DDI + DDD + número, sem símbolos.
ALERT_WHATSAPP_TO=5511999999999
WHATSAPP_ACCESS_TOKEN=seu_token_da_meta
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
WHATSAPP_GRAPH_API_VERSION=v23.0

# Para alertas iniciados pelo sistema, informe um template aprovado com
# cabeçalho de imagem e cinco variáveis no corpo: câmera, data, hora,
# confiança e mini relatório. Sem template, o envio direto só funciona
# dentro da janela de atendimento do WhatsApp.
WHATSAPP_TEMPLATE_NAME=alerta_queda_ai_health
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
